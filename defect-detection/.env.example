APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000

DB_URL=sqlite:///./data/defects.db

MODEL_MEMORY_BANK_PATH=./artifacts/patchcore_memory_bank.pt
MODEL_BACKBONE=wide_resnet50_2
MODEL_THRESHOLD=0.5
MODEL_DEVICE=cpu
IMAGE_SIZE=224

# Render free tier (512 MB) — set RENDER=true or LOW_MEMORY=true
# LOW_MEMORY=true
# IMAGE_SIZE=128
# CORESET_SAMPLING_RATIO=0.04
# INFERENCE_CHUNK_SIZE=256
# TRAIN_BATCH_SIZE=2
# BOOTSTRAP_TRAIN_IMAGES=6
# FEATURE_LAYERS=layer3
# NUM_NEIGHBORS=3

UPLOAD_DIR=./data/uploads
TRAIN_DIR=./data/custom/train/good
LOG_LEVEL=info

# Comma-separated browser origins for the frontend
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
